# --- MongoDB (Better Auth + Admissions + Certificates) ---
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/bengal"
MONGODB_DB="bengal"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google sign-in / Drive (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- AI / Maps / Firecrawl (optional) ---
GEMINI_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
FIRECRAWL_API_KEY=""
ADMIN_EMAILS=""   # optional, comma-separated; restricts Firecrawl agent to staff
